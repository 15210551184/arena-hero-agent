# AI review is disabled unless this flag is explicitly true.
ARENA_SUPERVISOR_AI_ENABLED=false

# OpenAI Responses-compatible endpoint. Required only when AI review is enabled.
ARENA_SUPERVISOR_AI_BASE_URL=https://example.invalid/v1
ARENA_SUPERVISOR_AI_API_KEY=replace-with-your-model-api-key

# Tried in order. Use model IDs supported by your endpoint.
ARENA_SUPERVISOR_MODELS=model-a,model-b
